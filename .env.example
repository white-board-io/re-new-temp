SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Must be an address this SES account will send as, or the relay rejects it.
SMTP_FROM=noreply@renew.com

# Where enquiries land.
ENQUIRY_TO=pv.marketing@renew.com>

# Set to 1 to log the full SMTP conversation when diagnosing delivery.
SMTP_DEBUG=1
